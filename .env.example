# ── Backend (copy to backend/.env) ───────────────────
# Optional: App Platform / Docker set PORT; local default is 8000 in uvicorn CMD / python -m app.main
# PORT=8000
OPENROUTER_API_KEY=sk-or-v1-...
CRUSTDATA_API_KEY=
UNSILOED_API_KEY=
PRODUCTHUNT_API_KEY=
PRODUCTHUNT_API_SECRET=
USE_MOCK=true
BACKEND_URL=http://localhost:8000
# Optional: comma-separated browser origins if using NEXT_PUBLIC_API_DIRECT (see README)
# CORS_ORIGINS=https://your-frontend.ondigitalocean.app

# DigitalOcean: set if App Platform "routing rule" is e.g. /vc-analyst-backend
# APP_URL_PREFIX=/vc-analyst-backend

# DigitalOcean: route /api → this service with "path trimmed" (request path is /start-analysis)
# GATEWAY_STRIPS_API_PREFIX=true

# ── Frontend (copy vars below to frontend/.env.local) ─
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_API_DIRECT=false   # true = browser calls API URL directly (needs CORS_ORIGINS)
#
# Production (DigitalOcean): set on the *web* component — RUNTIME, encrypted optional:
# BACKEND_URL=https://YOUR-APP.ondigitalocean.app/vc-analyst-backend
# (API service base: no trailing slash; do NOT end with /api — path prefix only if your route uses one)
